# Copy to .env for local Docker Compose ONLY (NEVER commit .env to Git)
# SQL Server password requires >= 8 chars with at least 3 of: upper, lower, digit, symbol
MSSQL_IMAGE_TAG=2022-latest
MSSQL_SA_PASSWORD=Replace_With_Strong_Sql_Password_123!

# Generate a >= 32-byte Base64 signing key in Windows PowerShell:
# $b = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_KEY=REPLACE_WITH_BASE64_RANDOM_48_BYTES_MINIMUM_32_BYTES_FOR_HS256
JWT_ISSUER=ExpenseTracker.Api
JWT_AUDIENCE=ExpenseTracker.Client
OPENAPI_ENABLE_UI=true
CORS_ALLOWED_ORIGIN=http://localhost:3000
ALLOWED_HOSTS=localhost;127.0.0.1
API_PORT=8080
