{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "TimeZoneId": "Asia/Ho_Chi_Minh"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "DemoData": false
  },
  "OpenApi": {
    "EnableUi": false
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "ExpenseTracker.Api",
    "Audience": "ExpenseTracker.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "RateLimiting": {
    "PermitLimit": 10,
    "WindowSeconds": 60
  }
}
